<clickhouse>
    <!--
      开发依赖容器的日志配置。

      默认配置下 trace_log / text_log 会持续写入且长期保留，数月后可达上百 GB；
      后台 merge 与系统表缓存会占用大量内存，使 4 GB 的开发容器接近 max_server_memory_usage，
      导致单元测试中的普通 INSERT 被 OvercommitTracker 以 code 241 杀掉。

      这里关闭高写入的 trace/text 日志，并限制其余系统日志的保留天数。
      该配置通过 config.d 目录挂载生效；修改后需重建 clickhouse-server 容器。
    -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <latency_log remove="1"/>

    <query_log>
        <ttl>3</ttl>
    </query_log>
    <metric_log>
        <ttl>3</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>1</ttl>
    </asynchronous_metric_log>
    <processors_profile_log>
        <ttl>1</ttl>
    </processors_profile_log>
</clickhouse>
