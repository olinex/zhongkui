# syntax=docker/dockerfile:1.7
#
# zhongkui 前端镜像（linux/arm64）。
# 静态资源与 CPU 架构无关：在构建机原生架构上执行 pnpm build，
# 最终阶段只 COPY 静态文件到 arm64 Nginx，因此不需要 QEMU。
#
#   docker buildx build --platform linux/arm64 -f web/Dockerfile.arm64 -t zhongkui-web:local-arm64 .

FROM node:22-bookworm-slim AS build

ENV npm_config_registry=https://registry.npmmirror.com
RUN corepack enable && corepack prepare pnpm@10 --activate

WORKDIR /app
COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ .

ARG VITE_ZHONGKUI_BASE_URL=/api/v1
ENV VITE_ZHONGKUI_BASE_URL=${VITE_ZHONGKUI_BASE_URL}
RUN pnpm build

FROM --platform=linux/arm64 nginx:1.27-alpine

ENV NGINX_ENVSUBST_FILTER=ZKI_API_UPSTREAM \
    ZKI_API_UPSTREAM=http://zki:8080

COPY web/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
