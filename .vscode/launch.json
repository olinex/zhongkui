{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug run web",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/zki/main.go",
      "args": ["run", "web", "--config", "${workspaceFolder}/config.toml"],
      "env": {
        "ZKI_DEBUG": "true",
        "OTEL_ENABLED": "true",
        "OTEL_OTLP_ENDPOINT": "localhost:4317",
        "OTEL_SERVICE_NAME": "zki-web",
        "OTEL_OTLP_HEADERS": "uptrace-dsn=http://project1_secret@localhost:14318?grpc=4317",
        "OTEL_OTLP_COMPRESSION": "gzip",
        "OTEL_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "BASE2_EXPONENTIAL_BUCKET_HISTOGRAM",
        "OTEL_OTLP_METRICS_TEMPORALITY_PREFERENCE": "DELTA",
      }
    },
    {
      "name": "Debug run grpc",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/zki/main.go",
      "args": ["run", "grpc", "--config", "${workspaceFolder}/config.toml"],
      "env": {
        "ZKI_DEBUG": "true",
        "OTEL_ENABLED": "true",
        "OTEL_OTLP_ENDPOINT": "localhost:4317",
        "OTEL_SERVICE_NAME": "zki-grpc",
        "OTEL_OTLP_HEADERS": "uptrace-dsn=http://project1_secret@localhost:14318?grpc=4317",
        "OTEL_OTLP_COMPRESSION": "gzip",
        "OTEL_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "BASE2_EXPONENTIAL_BUCKET_HISTOGRAM",
        "OTEL_OTLP_METRICS_TEMPORALITY_PREFERENCE": "DELTA",
      }
    },
    {
      "name": "Debug run capture",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "asRoot": true,
      "console": "integratedTerminal",
      "program": "${workspaceFolder}/cmd/zki/main.go",
      "args": ["run", "capture", "--config", "${workspaceFolder}/config.toml"],
      "env": {
        "ZKI_DEBUG": "true",
        "OTEL_ENABLED": "true",
        "OTEL_OTLP_ENDPOINT": "localhost:4317",
        "OTEL_SERVICE_NAME": "zki-capture",
        "OTEL_OTLP_HEADERS": "uptrace-dsn=http://project1_secret@localhost:14318?grpc=4317",
        "OTEL_OTLP_COMPRESSION": "gzip",
        "OTEL_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "BASE2_EXPONENTIAL_BUCKET_HISTOGRAM",
        "OTEL_OTLP_METRICS_TEMPORALITY_PREFERENCE": "DELTA",
      }
    },
    {
      "name": "Debug run worker",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/zki/main.go",
      "args": ["run", "worker", "--config", "${workspaceFolder}/config.toml"],
      "env": {
        "ZKI_DEBUG": "true",
        "OTEL_ENABLED": "true",
        "OTEL_OTLP_ENDPOINT": "localhost:4317",
        "OTEL_SERVICE_NAME": "zki-worker",
        "OTEL_OTLP_HEADERS": "uptrace-dsn=http://project1_secret@localhost:14318?grpc=4317",
        "OTEL_OTLP_COMPRESSION": "gzip",
        "OTEL_OTLP_METRICS_DEFAULT_HISTOGRAM_AGGREGATION": "BASE2_EXPONENTIAL_BUCKET_HISTOGRAM",
        "OTEL_OTLP_METRICS_TEMPORALITY_PREFERENCE": "DELTA",
      }
    }
  ]
}
