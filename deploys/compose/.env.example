# zhongkui Docker Compose 环境变量
#
# 复制为 .env 后替换所有 <CHANGE_ME>：
#   cp .env.example .env
# 生成随机口令示例：
#   openssl rand -hex 16     # 数据库/Redis/S3 口令
#   openssl rand -hex 32     # 主密钥

# 镜像仓库与版本（生产请固定为发布 tag）
ZKI_CORE_IMAGE=zhongkui-cn-beijing.cr.volces.com/open-source/zhongkui-core
ZKI_WEB_IMAGE=zhongkui-cn-beijing.cr.volces.com/open-source/zhongkui-web
ZKI_VERSION=latest

# 依赖镜像源：默认 Docker Hub；网络受限时改为镜像加速地址（保留后续路径）
IMAGE_REGISTRY=docker.io
# etcd 来自 quay.io；镜像源不代理 quay 时改为私有仓库中的同一镜像
ETCD_IMAGE=quay.io/coreos/etcd:v3.6.5

# 对外端口
ZKI_WEB_PORT=80
ZKI_API_PORT=8080
ZKI_GRPC_PORT=8081

# 宿主机端口（默认值如下；与同机已有服务冲突时改这里，仅影响宿主机访问，不影响容器互通）
ZKI_API_HEALTH_PORT=19090
POSTGRES_HOST_PORT=5432
CLICKHOUSE_HOST_PORT=9000
CLICKHOUSE_HTTP_HOST_PORT=8123
REDIS_HOST_PORT=6379
ETCD_HOST_PORT=2379
RUSTFS_HOST_PORT=9002
RUSTFS_CONSOLE_HOST_PORT=9001
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318

# 依赖口令
POSTGRES_PASSWORD=<CHANGE_ME>
CLICKHOUSE_PASSWORD=<CHANGE_ME>
REDIS_PASSWORD=<CHANGE_ME>
S3_ACCESS_KEY=<CHANGE_ME>
S3_SECRET_KEY=<CHANGE_ME>

# 主密钥：必须固定并备份，丢失后历史密文不可解密
ZKI_PARENT_SECRET_KEY=<CHANGE_ME>

# OpenTelemetry：默认关闭；启用后需同时启动 `--profile otel`
OTEL_ENABLED=false
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=
