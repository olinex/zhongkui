# zhongkui OpenTelemetry 环境变量示例
#
# 默认关闭。复制到 /etc/zhongkui/otel.env 并按需修改：
#   sudo cp deploys/binary/otel.env.example /etc/zhongkui/otel.env
#   sudo chmod 640 /etc/zhongkui/otel.env
# systemd unit 已通过 EnvironmentFile=-/etc/zhongkui/otel.env 加载本文件。
# 注意：OTEL_SERVICE_NAME 由各 unit 单独设置，不要写在这里。

# 总开关：必须显式设为 true 才会上报
OTEL_ENABLED=false

# 导出方式：otlp（默认）或 stdout（本地自检，无后端）
OTEL_PROVIDER=otlp

# OTLP 协议：grpc（默认 4317）或 http（默认 4318）
OTEL_OTLP_PROTOCOL=grpc

# ============================ 方案一：接入外部 Collector / APM ============================
# OTLP gRPC 端点；HTTP 协议时改为 http://collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# 认证头；Uptrace 形如 uptrace-dsn=http://<token>@<host>:14318?grpc=4317
# OTEL_EXPORTER_OTLP_HEADERS=
# 建议开启压缩
# OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# 明文 OTLP 时设为 true（端点已用 http:// 时通常可省略）
# OTEL_EXPORTER_OTLP_INSECURE=true

# ============================ 方案二：stdout 自检 ============================
# 不需要任何后端，trace/metric/log 直接打印到进程 stdout：
# OTEL_ENABLED=true
# OTEL_PROVIDER=stdout

# 采样策略：always_on（默认）/ head / tail
OTEL_SAMPLER_TYPE=always_on
# 仅 head 生效，0.0 ~ 1.0
OTEL_SAMPLER_RATIO=1.0
# 仅 tail 生效：只保留状态为 Error 的 Span
OTEL_TAIL_ON_ERROR=true

# 资源属性；deployment.environment 也可通过 ZKI_ENVIRONMENT 设置
OTEL_RESOURCE_ATTRIBUTES=service.namespace=zhongkui
